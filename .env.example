# Copie este arquivo para ".env" e preencha. O ".env" NUNCA vai para o Git.

# --- Aplicação ---
APP_ENV=development
APP_SECRET_KEY=troque-por-um-texto-aleatorio-longo
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/rpg.db

# --- Modo administrador ---
# Senha exigida para usar /admin e /debug (mesmo rodando no seu computador)
ADMIN_PASSWORD=troque-esta-senha

# --- IA usada para narrar ---
# Provedor (ver docs/AI_PROVIDERS.md):
#   "ollama"      - IA local, grátis, roda no seu computador (lenta em PC sem placa de vídeo)
#   "gemini"      - Google Gemini na internet, uso gratuito (precisa de GEMINI_API_KEY)
#   "groq"        - Groq na internet, uso gratuito (precisa de GROQ_API_KEY)
#   "openrouter"  - OpenRouter, SÓ modelos gratuitos ":free" (precisa de OPENROUTER_API_KEY)
#   "openai_compat" - outro servidor no formato OpenAI (LM Studio, llama.cpp...)
AI_PROVIDER=ollama
# Nome do modelo. Vazio = escolha automática (Ollama: primeiro instalado; serviços: o recomendado).
AI_MODEL=
# Criatividade (0 a 2). Mais alto = mais variado e menos previsível.
AI_TEMPERATURE=0.8
# Tamanho máximo de cada resposta, em tokens (pedaços de palavra).
AI_MAX_OUTPUT_TOKENS=1024
# Quanto texto o modelo consegue considerar de uma vez, em tokens. Mais = mais memória RAM.
AI_CONTEXT_WINDOW=8192
# Tempo máximo de espera por uma resposta (segundos). IA local em CPU pode ser lenta.
AI_TIMEOUT_SECONDS=600
# Motor de regras nos turnos: a IA propõe operações (testes, dano, itens...) e o motor valida e aplica.
# Usa uma chamada extra à IA por turno. "false" = só narração (mais rápido, sem ficha de personagem).
AI_MECHANICS=true
# Quantas vezes pedir de novo quando a IA devolve um JSON inválido (1 a 5).
AI_JSON_ATTEMPTS=2
# A cada quantos turnos a IA resume a história (memória de longo prazo). 0 = nunca.
# O resumo roda em segundo plano, depois do turno; não atrasa o jogo.
AI_SUMMARY_EVERY=8
# Quando um turno faz o tempo do mundo passar pelo menos isto (em minutos), a IA simula o que os
# personagens importantes fizeram longe do protagonista e os acontecimentos do mundo. 0 = nunca.
AI_SIMULATION_MINUTES=360

# --- Provedores de IA (preencha só os que for usar) ---
# Local (Ollama): grátis, roda no seu computador
OLLAMA_BASE_URL=http://localhost:11434

# Serviços na internet com uso GRATUITO (crie a chave no site; não cadastre cartão/faturamento)
# Gemini: https://aistudio.google.com/apikey · Groq: https://console.groq.com/keys · OpenRouter: https://openrouter.ai/keys
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Servidores no formato da OpenAI (LM Studio, llama.cpp, Ollama em /v1, serviços externos)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
# O servidor cobra? Serviços PAGOS ficam bloqueados (sem controle de gasto ainda). Gratuito/local: false.
OPENAI_COMPAT_PAID=true

# Anthropic (Claude) — serviço pago
ANTHROPIC_API_KEY=

# --- Cópias de segurança ---
# Snapshot automático de cada campanha a cada N jogadas concluídas (ficam os 5 mais recentes). 0 = nunca.
# Ficam em data/backups/<campanha>/ e podem ser restaurados com /admin snapshot.restore <id>.
AUTO_SNAPSHOT_EVERY=20

# --- Controle de gasto ---
# Limite de gasto estimado por sessão (na moeda do provedor). 0 = bloquear serviços pagos.
AI_SPEND_LIMIT_PER_SESSION=0

# --- Hospedagem (opcional; ver docs/HOSTING.md) ---
# Pasta do frontend compilado (npm run build) para o backend servir o jogo inteiro numa porta só.
# Vazio = desligado (em casa, o iniciar.cmd usa o servidor do Vite).
FRONTEND_DIST=

# --- Imagens (opcional; o jogo funciona sem) ---
IMAGE_PROVIDER=none
IMAGE_API_KEY=
