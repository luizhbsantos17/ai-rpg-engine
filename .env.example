# Copie este arquivo para ".env" e preencha. O ".env" NUNCA vai para o Git.

# --- Aplicação ---
APP_ENV=development
APP_SECRET_KEY=troque-por-um-texto-aleatorio-longo
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/rpg.db

# --- Modo administrador ---
# Senha exigida para usar /admin e /debug (mesmo rodando no seu computador)
ADMIN_PASSWORD=troque-esta-senha

# --- IA usada para narrar ---
# Provedor: "ollama" (local, grátis). Outros serão adicionados nas próximas etapas.
AI_PROVIDER=ollama
# Nome do modelo (ex.: o que aparece em "ollama list"). Vazio = primeiro modelo instalado.
AI_MODEL=
# Criatividade (0 a 2). Mais alto = mais variado e menos previsível.
AI_TEMPERATURE=0.8
# Tamanho máximo de cada resposta, em tokens (pedaços de palavra).
AI_MAX_OUTPUT_TOKENS=1024
# Quanto texto o modelo consegue considerar de uma vez, em tokens. Mais = mais memória RAM.
AI_CONTEXT_WINDOW=8192
# Tempo máximo de espera por uma resposta (segundos). IA local em CPU pode ser lenta.
AI_TIMEOUT_SECONDS=600
# Motor de regras nos turnos: a IA propõe operações (testes, dano, itens...) e o motor valida e aplica.
# Usa uma chamada extra à IA por turno. "false" = só narração (mais rápido, sem ficha de personagem).
AI_MECHANICS=true
# Quantas vezes pedir de novo quando a IA devolve um JSON inválido (1 a 5).
AI_JSON_ATTEMPTS=2

# --- Provedores de IA (preencha só os que for usar) ---
# Local (Ollama): grátis, roda no seu computador
OLLAMA_BASE_URL=http://localhost:11434

# APIs compatíveis com o formato da OpenAI (vários provedores usam esse formato)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# Anthropic (Claude) — serviço pago
ANTHROPIC_API_KEY=

# --- Controle de gasto ---
# Limite de gasto estimado por sessão (na moeda do provedor). 0 = bloquear serviços pagos.
AI_SPEND_LIMIT_PER_SESSION=0

# --- Imagens (opcional; o jogo funciona sem) ---
IMAGE_PROVIDER=none
IMAGE_API_KEY=
